{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dB-Deck",
  "version": "0.1.0",
  "identifier": "app.dbdeck.mixer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dB-Deck",
        "width": 1320,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "backgroundColor": "#121417"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "dB-Deck contributors",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Free Windows audio mixer",
    "longDescription": "dB-Deck is a free, open-source Windows audio mixer with per-application volume control, unlimited channels and buses, and real audio routing.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/dbdeck-engine"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../../../installer/nsis-hooks.nsh"
      }
    }
  }
}
