{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dbdeck.app/schemas/config-v1.json",
  "title": "dB-Deck configuration (schema version 1)",
  "description": "Documents %APPDATA%/dB-Deck/config.json. The engine validates the same rules in code (engine/core/graph/Model.cpp): wrong types are rejected with a path, out-of-range numbers are clamped, dangling references are repaired.",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "activeProfileId": { "type": "string" },
    "settings": {
      "type": "object",
      "properties": {
        "bufferMode": { "enum": ["low", "normal", "safe"] },
        "meterRateHz": { "type": "number", "minimum": 5, "maximum": 60 },
        "showSystemSounds": { "type": "boolean" }
      }
    },
    "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } }
  },
  "$defs": {
    "send": {
      "type": "object",
      "required": ["busId"],
      "properties": {
        "busId": { "type": "string" },
        "enabled": { "type": "boolean" },
        "gain": { "type": "number", "minimum": 0, "maximum": 2 },
        "preFader": { "type": "boolean" }
      }
    },
    "effect": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["gain", "eq", "gate", "compressor", "limiter"] },
        "enabled": { "type": "boolean" },
        "params": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "channel": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "enum": ["app", "hardwareInput", "endpointLoopback", "testTone"] },
        "match": {
          "type": "object",
          "properties": {
            "exeNames": { "type": "array", "items": { "type": "string" } },
            "pathContains": { "type": "string" }
          }
        },
        "appCapture": { "type": "boolean" },
        "deviceId": { "type": "string" },
        "deviceName": { "type": "string" },
        "toneHz": { "type": "number", "minimum": 20, "maximum": 20000 },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "gainDb": { "type": "number", "minimum": -60, "maximum": 24 },
        "balance": { "type": "number", "minimum": -1, "maximum": 1 },
        "mute": { "type": "boolean" },
        "groupId": { "type": "string" },
        "sends": { "type": "array", "items": { "$ref": "#/$defs/send" } },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "reconnect": { "enum": ["auto", "manual"] }
      }
    },
    "group": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "mute": { "type": "boolean" },
        "collapsed": { "type": "boolean" }
      }
    },
    "bus": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "isMain": { "type": "boolean" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "mute": { "type": "boolean" },
        "deviceId": { "type": "string" },
        "deviceName": { "type": "string" },
        "fallbackDeviceIds": { "type": "array", "items": { "type": "string" } },
        "busSends": { "type": "array", "items": { "$ref": "#/$defs/send" } },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } }
      }
    },
    "profile": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
        "buses": { "type": "array", "items": { "$ref": "#/$defs/bus" } },
        "scenes": { "type": "array" },
        "layout": { "type": "object" }
      }
    }
  }
}
